{
  "name": "liftrank-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && tsc -b && vite build",
    "build:demo": "VITE_PUBLIC_DEMO=true VITE_AUTH_DEMO_MODE=true pnpm build",
    "preview": "vite preview",
    "test": "vitest run tests && node --test scripts/gym-sources/*.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:demo": "pnpm build:demo && playwright test --config=playwright.demo.config.ts",
    "perf": "VITE_PUBLIC_DEMO=true VITE_AUTH_DEMO_MODE=true pnpm build && playwright test --config=playwright.performance.config.ts",
    "gyms:update": "node scripts/update-gym-catalog.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}

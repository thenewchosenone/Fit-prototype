VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Keep both false for the future production application.
VITE_AUTH_DEMO_MODE=false
VITE_PUBLIC_DEMO=false
# Focused launch default. Enable only in an intentional internal test session.
VITE_ENABLE_DEFERRED_FEATURES=false

# Optional server-side auth test runner. Put these ONLY in .env.staging-auth
# (gitignored, chmod 600) or the GitHub staging-auth environment secrets.
# Never prefix the server key with VITE_ or ship it in any app bundle.
# STAGING_AUTH_URL=https://dfpvamnucwyafxklnjwt.supabase.co
# STAGING_AUTH_PUBLIC_KEY=staging_public_key
# STAGING_AUTH_SERVER_KEY=staging_server_key
